pipeline {
    agent {
        label 'adi'
    }

    tools {
        nodejs 'NodeJS-24'
    }

    parameters {
        booleanParam(
            name: 'RUN_CD',
            defaultValue: false,
            description: 'Trigger MRD-CD after images are pushed'
        )
    }

    options {
        timestamps()
        disableConcurrentBuilds()
        skipDefaultCheckout(true)

        buildDiscarder(
            logRotator(
                numToKeepStr: '10',
                artifactNumToKeepStr: '5'
            )
        )
    }

    environment {
        DOCKERHUB_USERNAME = 'aadityasharma96'
        BACKEND_IMAGE = "${DOCKERHUB_USERNAME}/multi-region-dashboard-backend"
        FRONTEND_IMAGE = "${DOCKERHUB_USERNAME}/multi-region-dashboard-frontend"
        DOCKER_BUILDKIT = '1'
        TRIVY_CACHE_DIR = '/home/ubuntu/.cache/trivy'
    }

    stages {
        stage('Clean Workspace') {
            steps {
                deleteDir()
            }
        }

        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        stage('Verify Repository') {
            steps {
                sh '''
                    set -e

                    test -f frontend/package.json
                    test -f frontend/package-lock.json
                    test -f frontend/Dockerfile
                    test -f frontend/nginx.conf

                    test -f backend/package.json
                    test -f backend/package-lock.json
                    test -f backend/Dockerfile
                    test -f backend/src/app.js
                    test -f backend/src/services/awsServices.js
                    test -f backend/src/routes/dashboard.js

                    test -f docker-compose.yml
                    test -f k8s/base/kustomization.yaml
                    test -f k8s/overlays/production/kustomization.yaml
                    test -f gitops/Jenkins-CD

                    echo "Repository verification passed."
                '''
            }
        }

        stage('Set Image Tag') {
            steps {
                script {
                    env.GIT_SHORT_SHA = sh(
                        script: 'git rev-parse --short=8 HEAD',
                        returnStdout: true
                    ).trim()

                    env.IMAGE_TAG = "${env.BUILD_NUMBER}-${env.GIT_SHORT_SHA}"

                    echo "Docker image tag: ${env.IMAGE_TAG}"
                }
            }
        }

        stage('Check Tools') {
            steps {
                sh '''
                    set -e

                    echo "Pipeline user:"
                    whoami
                    id

                    git --version
                    node --version
                    npm --version
                    docker --version
                    docker compose version
                    docker buildx version
                    trivy --version
                    kustomize version
                    kubectl version --client
                    aws --version

                    NODE_MAJOR="$(node -p "process.versions.node.split('.')[0]")"

                    if [ "$NODE_MAJOR" != "24" ]; then
                        echo "ERROR: Node.js 24 is required."
                        exit 1
                    fi

                    if ! kubectl version --client -o yaml |
                        grep -Eq 'gitVersion: v1\\.35\\.'; then
                        echo "ERROR: kubectl 1.35.x is required."
                        exit 1
                    fi

                    docker info >/dev/null

                    curl -fsS \
                      http://127.0.0.1:9000/api/system/status |
                      grep -q '"status":"UP"'

                    test -d "$TRIVY_CACHE_DIR"
                    test -w "$TRIVY_CACHE_DIR"

                    echo "All required tools are working."
                    echo "SonarQube is running."
                '''
            }
        }

        stage('Frontend Install') {
            steps {
                dir('frontend') {
                    sh '''
                        set -e

                        rm -rf node_modules dist

                        npm ci \
                          --no-audit \
                          --no-fund

                        echo "Frontend dependencies installed."
                    '''
                }
            }
        }

        stage('Frontend Security') {
            steps {
                dir('frontend') {
                    sh '''
                        set -e

                        npm audit \
                          --audit-level=critical

                        echo "Frontend npm audit passed."
                    '''
                }
            }
        }

        stage('Frontend Lint and Build') {
            steps {
                dir('frontend') {
                    sh '''
                        set -e

                        npm run lint
                        npm run build

                        test -f dist/index.html

                        echo "Frontend build passed."
                    '''
                }
            }
        }

        stage('Archive Frontend Build') {
            steps {
                archiveArtifacts(
                    artifacts: 'frontend/dist/**',
                    fingerprint: true,
                    allowEmptyArchive: false
                )
            }
        }

        stage('Backend Install') {
            steps {
                dir('backend') {
                    sh '''
                        set -e

                        rm -rf node_modules

                        npm ci \
                          --no-audit \
                          --no-fund

                        echo "Backend dependencies installed."
                    '''
                }
            }
        }

        stage('Backend Security') {
            steps {
                dir('backend') {
                    sh '''
                        set -e

                        npm audit \
                          --omit=dev \
                          --audit-level=critical

                        echo "Backend npm audit passed."
                    '''
                }
            }
        }

        stage('Backend Syntax Check') {
            steps {
                dir('backend') {
                    sh '''
                        set -e

                        node --check src/app.js
                        node --check src/services/awsServices.js
                        node --check src/routes/dashboard.js

                        if [ -f src/middleware/cache.js ]; then
                            node --check src/middleware/cache.js
                        fi

                        echo "Backend syntax checks passed."
                    '''
                }
            }
        }

        stage('SonarQube Analysis') {
            steps {
                script {
                    def scannerHome = tool 'SonarScanner'

                    withEnv(["SCANNER_HOME=${scannerHome}"]) {
                        withSonarQubeEnv('SonarQube-Server') {
                            sh '''
                                set -e

                                "$SCANNER_HOME/bin/sonar-scanner" \
                                  -Dsonar.projectKey=multi-region-dashboard \
                                  -Dsonar.projectName="Multi Region Dashboard" \
                                  -Dsonar.projectVersion="$IMAGE_TAG" \
                                  -Dsonar.sources=frontend/src,backend/src \
                                  -Dsonar.exclusions="**/node_modules/**,frontend/dist/**,**/coverage/**" \
                                  -Dsonar.sourceEncoding=UTF-8

                                echo "SonarQube analysis completed."
                            '''
                        }
                    }
                }
            }
        }

        stage('SonarQube Quality Gate') {
            steps {
                timeout(time: 10, unit: 'MINUTES') {
                    waitForQualityGate abortPipeline: true
                }
            }
        }

        stage('OWASP Dependency Check') {
            steps {
                timeout(time: 90, unit: 'MINUTES') {
                    dependencyCheck(
                        odcInstallation: 'OWASP-Dependency-Check',
                        nvdCredentialsId: 'nvd-api-key',
                        additionalArguments: '--project "Multi Region Dashboard" --scan frontend --scan backend --format XML --format HTML --out dependency-check-report --data /home/ubuntu/.cache/dependency-check --nvdMaxRetryCount 10',
                        stopBuild: true
                    )
                }
            }

            post {
                always {
                    dependencyCheckPublisher(
                        pattern: 'dependency-check-report/dependency-check-report.xml',
                        failedTotalCritical: 1,
                        stopBuild: true,
                        skipNoReportFiles: true
                    )

                    archiveArtifacts(
                        artifacts: 'dependency-check-report/**',
                        allowEmptyArchive: true,
                        fingerprint: true
                    )
                }
            }
        }

        stage('Validate Docker Compose') {
            steps {
                sh '''
                    set -e

                    CREATED_ENV=0

                    cleanup_ci_env() {
                        if [ "$CREATED_ENV" -eq 1 ]; then
                            rm -f backend/.env
                        fi
                    }

                    trap cleanup_ci_env EXIT

                    if [ ! -f backend/.env ]; then
                        : > backend/.env
                        CREATED_ENV=1
                    fi

                    AWS_ACCESS_KEY_ID=ci-placeholder \
                    AWS_SECRET_ACCESS_KEY=ci-placeholder \
                    AWS_DEFAULT_REGION=us-east-1 \
                    docker compose config --quiet

                    echo "Docker Compose validation passed."
                '''
            }
        }

        stage('Validate Kubernetes YAML') {
            steps {
                sh '''
                    set -e

                    RENDERED_FILE="$(mktemp)"

                    cleanup_rendered_file() {
                        rm -f "$RENDERED_FILE"
                    }

                    trap cleanup_rendered_file EXIT

                    kustomize build \
                      k8s/overlays/production \
                      > "$RENDERED_FILE"

                    test -s "$RENDERED_FILE"

                    grep -Fq "kind: Namespace" "$RENDERED_FILE"
                    grep -Fq "name: dashboard" "$RENDERED_FILE"
                    grep -Fq "name: aws-dashboard-backend" "$RENDERED_FILE"
                    grep -Fq "name: aws-dashboard-frontend" "$RENDERED_FILE"
                    grep -Fq "name: aws-dashboard-backend-service" "$RENDERED_FILE"
                    grep -Fq "name: aws-dashboard-frontend-service" "$RENDERED_FILE"
                    grep -Fq "nodePort: 30080" "$RENDERED_FILE"

                    echo "Kubernetes manifest validation passed."
                '''
            }
        }

        stage('Build Docker Images') {
            steps {
                sh '''
                    set -e

                    docker build \
                      --pull \
                      -t "$BACKEND_IMAGE:$IMAGE_TAG" \
                      -t "$BACKEND_IMAGE:latest" \
                      ./backend

                    docker build \
                      --pull \
                      -t "$FRONTEND_IMAGE:$IMAGE_TAG" \
                      -t "$FRONTEND_IMAGE:latest" \
                      ./frontend

                    docker image inspect \
                      "$BACKEND_IMAGE:$IMAGE_TAG" \
                      >/dev/null

                    docker image inspect \
                      "$FRONTEND_IMAGE:$IMAGE_TAG" \
                      >/dev/null

                    echo "Docker image builds passed."
                '''
            }
        }

        stage('Trivy Security Scan') {
            steps {
                sh '''
                    set -e

                    trivy image \
                      --cache-dir "$TRIVY_CACHE_DIR" \
                      --timeout 15m \
                      --exit-code 1 \
                      --severity CRITICAL \
                      --ignore-unfixed \
                      "$BACKEND_IMAGE:$IMAGE_TAG"

                    trivy image \
                      --cache-dir "$TRIVY_CACHE_DIR" \
                      --timeout 15m \
                      --exit-code 1 \
                      --severity CRITICAL \
                      --ignore-unfixed \
                      "$FRONTEND_IMAGE:$IMAGE_TAG"

                    echo "Trivy security scans passed."
                '''
            }
        }

        stage('Docker Login and Push') {
            steps {
                withCredentials([
                    usernamePassword(
                        credentialsId: 'dockerHubCred',
                        usernameVariable: 'DOCKER_USER',
                        passwordVariable: 'DOCKER_TOKEN'
                    )
                ]) {
                    sh '''
                        set -e
                        set +x

                        echo "$DOCKER_TOKEN" |
                        docker login \
                          --username "$DOCKER_USER" \
                          --password-stdin

                        docker push "$BACKEND_IMAGE:$IMAGE_TAG"
                        docker push "$BACKEND_IMAGE:latest"

                        docker push "$FRONTEND_IMAGE:$IMAGE_TAG"
                        docker push "$FRONTEND_IMAGE:latest"

                        docker logout

                        echo "Docker images pushed successfully."
                    '''
                }
            }
        }

        stage('Trigger CD') {
            when {
                expression {
                    return params.RUN_CD
                }
            }

            steps {
                build(
                    job: 'MRD-CD',
                    parameters: [
                        string(
                            name: 'IMAGE_TAG',
                            value: env.IMAGE_TAG
                        )
                    ],
                    wait: true,
                    propagate: true
                )
            }
        }
    }

    post {
        always {
            sh '''
                docker logout >/dev/null 2>&1 || true

                if [ -n "${IMAGE_TAG:-}" ]; then
                    docker image rm \
                      "$BACKEND_IMAGE:$IMAGE_TAG" \
                      "$FRONTEND_IMAGE:$IMAGE_TAG" \
                      "$BACKEND_IMAGE:latest" \
                      "$FRONTEND_IMAGE:latest" \
                      >/dev/null 2>&1 || true
                fi
            '''
        }

        success {
            echo "CI pipeline completed successfully."
        }

        unstable {
            echo "CI pipeline completed with security warnings."
        }

        failure {
            echo "CI pipeline failed. Check the failed stage."
        }
    }
}
