pipeline {
    agent {
        label 'adi'
    }

    tools {
        nodejs 'NodeJS-24'
    }

    options {
        timestamps()
        disableConcurrentBuilds()
        skipDefaultCheckout(true)

        buildDiscarder(
            logRotator(
                numToKeepStr: '10',
                artifactNumToKeepStr: '5'
            )
        )
    }

    environment {
        DOCKERHUB_USERNAME = 'aadityasharma96'
        BACKEND_IMAGE = "${DOCKERHUB_USERNAME}/multi-region-dashboard-backend"
        FRONTEND_IMAGE = "${DOCKERHUB_USERNAME}/multi-region-dashboard-frontend"
        DOCKER_BUILDKIT = '1'
    }

    stages {
        stage('Clean Workspace') {
            steps {
                deleteDir()
            }
        }

        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        stage('Verify Repository') {
            steps {
                sh '''
                    set -e

                    echo "Current workspace:"
                    pwd

                    echo "Root repository files:"
                    ls -la

                    echo "Checking frontend files..."
                    test -f frontend/package.json
                    test -f frontend/package-lock.json
                    test -f frontend/Dockerfile

                    echo "Checking backend files..."
                    test -f backend/package.json
                    test -f backend/package-lock.json
                    test -f backend/Dockerfile
                    test -f backend/src/app.js
                    test -f backend/src/services/awsServices.js
                    test -f backend/src/routes/dashboard.js

                    echo "Checking project files..."
                    test -f docker-compose.yml

                    echo "All required repository files are present."
                '''
            }
        }

        stage('Set Image Tag') {
            steps {
                script {
                    env.GIT_SHORT_SHA = sh(
                        script: 'git rev-parse --short=8 HEAD',
                        returnStdout: true
                    ).trim()

                    env.IMAGE_TAG = "${env.BUILD_NUMBER}-${env.GIT_SHORT_SHA}"

                    echo "Docker image tag: ${env.IMAGE_TAG}"
                }
            }
        }

        stage('Check Tools') {
            steps {
                sh '''
                    set -e

                    echo "Git:"
                    git --version

                    echo "Node:"
                    node --version

                    echo "npm:"
                    npm --version

                    echo "Docker:"
                    docker --version

                    echo "Docker Compose:"
                    docker compose version

                    echo "Checking Node.js major version..."

                    NODE_MAJOR="$(node -p "process.versions.node.split('.')[0]")"

                    if [ "$NODE_MAJOR" != "24" ]; then
                        echo "ERROR: Jenkins is using Node.js $(node --version)."
                        echo "Configure the NodeJS-24 tool with an actual Node.js 24.x version."
                        exit 1
                    fi

                    echo "Node.js 24 is configured correctly."

                    echo "Checking Docker daemon access..."
                    docker info >/dev/null

                    echo "All required tools are working."
                '''
            }
        }

        stage('Frontend Install') {
            steps {
                dir('frontend') {
                    sh '''
                        set -e

                        rm -rf node_modules dist

                        npm ci \
                          --no-audit \
                          --no-fund

                        echo "Frontend dependencies installed."
                    '''
                }
            }
        }

        stage('Frontend Security') {
            steps {
                dir('frontend') {
                    sh '''
                        set -e

                        npm audit \
                          --audit-level=high

                        echo "Frontend dependency security check passed."
                    '''
                }
            }
        }

        stage('Frontend Lint and Build') {
            steps {
                dir('frontend') {
                    sh '''
                        set -e

                        npm run lint
                        npm run build

                        test -f dist/index.html

                        echo "Frontend production build passed."
                    '''
                }
            }
        }

        stage('Archive Frontend Build') {
            steps {
                archiveArtifacts(
                    artifacts: 'frontend/dist/**',
                    fingerprint: true,
                    allowEmptyArchive: false
                )
            }
        }

        stage('Backend Install') {
            steps {
                dir('backend') {
                    sh '''
                        set -e

                        rm -rf node_modules

                        npm ci \
                          --no-audit \
                          --no-fund

                        echo "Backend dependencies installed."
                    '''
                }
            }
        }

        stage('Backend Security') {
            steps {
                dir('backend') {
                    sh '''
                        set -e

                        npm audit \
                          --omit=dev \
                          --audit-level=high

                        echo "Backend dependency security check passed."
                    '''
                }
            }
        }

        stage('Backend Syntax Check') {
            steps {
                dir('backend') {
                    sh '''
                        set -e

                        node --check src/app.js
                        node --check src/services/awsServices.js
                        node --check src/routes/dashboard.js

                        if [ -f src/middleware/cache.js ]; then
                            node --check src/middleware/cache.js
                        else
                            echo "src/middleware/cache.js not found. Skipping it."
                        fi

                        echo "Backend syntax checks passed."
                    '''
                }
            }
        }

        stage('Validate Docker Compose') {
            steps {
                sh '''
                    set -e

                    docker compose config --quiet

                    echo "Docker Compose configuration is valid."
                '''
            }
        }

        stage('Validate Kubernetes YAML') {
            steps {
                sh '''
                    set -e

                    if [ ! -d k8s ]; then
                        echo "No k8s directory found. Skipping Kubernetes validation."
                        exit 0
                    fi

                    if command -v kubectl >/dev/null 2>&1; then
                        kubectl apply \
                          --dry-run=client \
                          --validate=false \
                          -f k8s/

                        echo "Kubernetes manifests passed client validation."
                    else
                        echo "kubectl is not installed on the Jenkins agent."
                        echo "Skipping Kubernetes validation."
                    fi
                '''
            }
        }

        stage('Build Docker Images') {
            steps {
                sh '''
                    set -e

                    echo "Building backend Docker image..."

                    docker build \
                      --pull \
                      -t "$BACKEND_IMAGE:$IMAGE_TAG" \
                      -t "$BACKEND_IMAGE:latest" \
                      ./backend

                    echo "Building frontend Docker image..."

                    docker build \
                      --pull \
                      -t "$FRONTEND_IMAGE:$IMAGE_TAG" \
                      -t "$FRONTEND_IMAGE:latest" \
                      ./frontend

                    echo "Verifying backend Docker image..."

                    docker image inspect \
                      "$BACKEND_IMAGE:$IMAGE_TAG" \
                      >/dev/null

                    echo "Verifying frontend Docker image..."

                    docker image inspect \
                      "$FRONTEND_IMAGE:$IMAGE_TAG" \
                      >/dev/null

                    echo "Both Docker images were built successfully."
                '''
            }
        }

        stage('Trivy Security Scan') {
            steps {
                sh '''
                    set -e

                    if command -v trivy >/dev/null 2>&1; then
                        echo "Scanning backend Docker image..."

                        trivy image \
                          --exit-code 1 \
                          --severity HIGH,CRITICAL \
                          --ignore-unfixed \
                          "$BACKEND_IMAGE:$IMAGE_TAG"

                        echo "Scanning frontend Docker image..."

                        trivy image \
                          --exit-code 1 \
                          --severity HIGH,CRITICAL \
                          --ignore-unfixed \
                          "$FRONTEND_IMAGE:$IMAGE_TAG"

                        echo "Trivy security scans passed."
                    else
                        echo "Trivy is not installed on the Jenkins agent."
                        echo "Skipping Trivy security scan."
                    fi
                '''
            }
        }

        stage('Docker Login and Push') {
            steps {
                withCredentials([
                    usernamePassword(
                        credentialsId: 'dockerHubCred',
                        usernameVariable: 'DOCKER_USER',
                        passwordVariable: 'DOCKER_TOKEN'
                    )
                ]) {
                    sh '''
                        set -e
                        set +x

                        echo "$DOCKER_TOKEN" |
                        docker login \
                          --username "$DOCKER_USER" \
                          --password-stdin

                        echo "Pushing backend versioned image..."

                        docker push \
                          "$BACKEND_IMAGE:$IMAGE_TAG"

                        echo "Pushing backend latest image..."

                        docker push \
                          "$BACKEND_IMAGE:latest"

                        echo "Pushing frontend versioned image..."

                        docker push \
                          "$FRONTEND_IMAGE:$IMAGE_TAG"

                        echo "Pushing frontend latest image..."

                        docker push \
                          "$FRONTEND_IMAGE:latest"

                        docker logout

                        echo "Both Docker images were pushed successfully."
                    '''
                }
            }
        }
    }
}
